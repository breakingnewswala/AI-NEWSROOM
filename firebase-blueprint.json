{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control (Master Admin vs Channel Admin) and social connections",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User Firebase Auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User Google email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar image URL",
          "maxLength": 1000
        },
        "role": {
          "type": "string",
          "enum": ["MASTER_ADMIN", "CHANNEL_ADMIN"],
          "description": "Role in AI Newsroom platform"
        },
        "channelName": {
          "type": "string",
          "description": "District channel or media house title",
          "maxLength": 128
        },
        "channelLogo": {
          "type": "string",
          "description": "Channel custom logo URL or base64 image",
          "maxLength": 500000
        },
        "district": {
          "type": "string",
          "description": "Associated district or state",
          "maxLength": 64
        },
        "facebookConnected": {
          "type": "boolean",
          "description": "Facebook Page OAuth link state"
        },
        "youtubeConnected": {
          "type": "boolean",
          "description": "YouTube Channel OAuth link state"
        },
        "instagramConnected": {
          "type": "boolean",
          "description": "Instagram Creator account connection"
        },
        "twitterConnected": {
          "type": "boolean",
          "description": "X / Twitter connection"
        },
        "linkedinConnected": {
          "type": "boolean",
          "description": "LinkedIn Page connection"
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending", "suspended"],
          "description": "Account activation status"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "role"]
    },
    "NewsCard": {
      "title": "NewsCard",
      "description": "Represents an automated or manual news card item for 4:5 graphics and broadcast publishing.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the news card"
        },
        "district": {
          "type": "string",
          "description": "English district name",
          "maxLength": 64
        },
        "districtHindi": {
          "type": "string",
          "description": "Hindi district name",
          "maxLength": 64
        },
        "headline": {
          "type": "string",
          "description": "Main catchy headline in Hindi",
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "description": "Summary of the news story",
          "maxLength": 1000
        },
        "bulletPoints": {
          "type": "array",
          "description": "Key bullet highlights for the 4:5 graphic"
        },
        "caption": {
          "type": "string",
          "description": "Multi-channel social caption with hashtags",
          "maxLength": 4000
        },
        "image": {
          "type": "string",
          "description": "Image URL for the graphic background",
          "maxLength": 1000
        },
        "page": {
          "type": "string",
          "description": "Target publishing page name",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["pending", "published"],
          "description": "Approval queue status"
        },
        "urgency": {
          "type": "string",
          "enum": ["Breaking", "Top Story", "Normal", "Viral"],
          "description": "Urgency rating"
        },
        "category": {
          "type": "string",
          "description": "News category",
          "maxLength": 128
        },
        "accent": {
          "type": "string",
          "description": "Graphic accent theme: Red, Gold, or Blue",
          "maxLength": 32
        },
        "filter": {
          "type": "string",
          "description": "Image filter: none, grayscale, sepia, or high-contrast",
          "maxLength": 32
        },
        "createdBy": {
          "type": "string",
          "description": "UID of admin creator",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO string",
          "maxLength": 64
        }
      },
      "required": ["district", "headline", "status"]
    },
    "AutomationRule": {
      "title": "AutomationRule",
      "description": "RSS feed scraping and automated posting rules",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Rule identifier"
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "district": {
          "type": "string",
          "maxLength": 64
        },
        "url": {
          "type": "string",
          "maxLength": 512
        },
        "target": {
          "type": "string",
          "maxLength": 128
        },
        "mode": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": ["name", "url", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered Master Admin and Channel Admins profiles"
    },
    "/news_cards/{cardId}": {
      "schema": "NewsCard",
      "description": "Collection of news cards in the control room approval queue and published archive"
    },
    "/automation_rules/{ruleId}": {
      "schema": "AutomationRule",
      "description": "Collection of district RSS automation and syndication rules"
    }
  }
}
